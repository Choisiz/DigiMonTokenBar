# Swift Package Manager
.build/
.build-cyber/
.build-branches/
.swiftpm/
Package.resolved

# App bundle build output
build/

# OMC / agent local state
.omc/

# macOS
.DS_Store
*.xcuserstate

# Signing material — never commit private keys / certs
*.p12
*.pem
*.key
*.cer
*.certSigningRequest

# Personal dev notes (kept locally, not published).
# docs/reference/ is the exception: published agent/contributor reference docs.
# (Must ignore docs/* rather than docs/ — git cannot re-include inside an excluded directory.)
docs/*
!docs/reference/

# Agent worktrees / local state
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/prepare-pr
.worktrees/

# Local-only review-gate opt-out (not published)
.no-review-gate

# Local QA saves include a private snapshot of user progress.
assets/fusion-test-saves/

# Local instrumentation and mutation crash logs; retain review screenshots.
assets/*/*.profdata
assets/*/*.profraw
assets/*/coverage*.log
assets/*/coverage-core.txt
assets/*/mutation-*.txt

# Digimon review previews contain downloaded artwork; keep them local.
# Previously tracked upstream examples remain in their original history.
/assets/
# Remote originals must never be added back to the resource bundle.
/Sources/PokeTokenBar/Resources/Digimon/[0-9]*.png
/Sources/PokeTokenBar/Resources/Digimon/[0-9]*.jpg
/Sources/PokeTokenBar/Resources/Digimon/capsule-*.png
/Sources/PokeTokenBar/Resources/Digimon/gennai.jpg
/Sources/PokeTokenBar/Resources/Digimon/digivice-adventure.png
/Sources/PokeTokenBar/Resources/Digimon/digitama-adventure.png
/Sources/PokeTokenBar/Resources/Digimon/evolution-tag.png

# Local agent instructions and development-only material are not published.
/AGENTS.md
/CLAUDE.md
/.agents/
/.claude/
/AGENTS.md.*
/PULL_REQUEST.md
/.github/FUNDING.yml
*.profraw
*.profdata
*.digitokenbar.save
*.pokesave
/companion-state*.json*
# Keep only maintained build/check tools in the public scripts directory.
/scripts/*
!/scripts/build-digimon-app.sh
!/scripts/check-digimon-artwork-distribution.py
!/scripts/package-digimon-app.sh
!/scripts/test-gate.sh
!/scripts/verify-digimon-package.py

# Public reference documentation only; captured data and internal QA stay local.
/docs/pr/
/docs/reference/*
!/docs/reference/digimon-continue-training.md
!/docs/reference/digimon-evolution-methods.md
!/docs/reference/digimon-korean-names.md
!/docs/reference/distribution-validation.md
!/docs/reference/runtime-artwork.md
