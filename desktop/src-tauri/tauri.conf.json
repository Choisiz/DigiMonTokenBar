{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigiMonTokenBar",
  "version": "0.2.11",
  "identifier": "com.choisiz.digimontokenbar.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DigiMonTokenBar",
        "width": 1060,
        "height": 860,
        "minWidth": 440,
        "minHeight": 620,
        "backgroundColor": "#020709",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'self'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}